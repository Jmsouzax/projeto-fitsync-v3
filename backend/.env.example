PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
# Segredo do webhook (Painel do MP > Webhooks). Se definido, a assinatura das
# notificações passa a ser OBRIGATÓRIA. Deixe em branco só em ambiente de demo.
MERCADOPAGO_WEBHOOK_SECRET=

# URLs usadas nas correções de segurança
# FRONTEND_URL: origens permitidas no CORS (separe várias por vírgula)
FRONTEND_URL=https://projeto-fitsync-v3.vercel.app
# BACKEND_URL: usada para montar a notification_url do Mercado Pago
BACKEND_URL=https://projeto-fitsync-v3.onrender.com
